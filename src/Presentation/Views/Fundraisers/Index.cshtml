@model FundraisersListViewModel
@{
    ViewData["Title"] = "Актуальні збори";
}

<section class="app-section">
    <div class="section-header">
        <h1 class="section-title">@ViewData["Title"]</h1>
        <p class="section-subtitle">Список зборів, які зараз потребують підтримки.</p>
    </div>

    @if (TempData["FundraiserSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["FundraiserError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="fundraisers-layout">
        <aside class="placeholder-card fundraisers-sidebar" aria-label="Фільтри зборів">
            <div class="fundraisers-sidebar__header">
                <p class="fundraisers-sidebar__kicker">Фільтрація</p>
                <h2 class="fundraisers-sidebar__title">Категорії</h2>
                <p class="fundraisers-sidebar__subtitle">Наразі доступні три основні категорії зборів.</p>
            </div>

            <div class="fundraisers-filter-group">
                <span class="fundraisers-filter-group__label">Категорія</span>
                <div class="fundraisers-filter-chips">
                    <span class="fundraisers-filter-chip fundraisers-filter-chip--active">Медицина</span>
                    <span class="fundraisers-filter-chip">Допомога ЗСУ</span>
                    <span class="fundraisers-filter-chip">Підтримка</span>
                </div>
            </div>

            <div class="fundraisers-filter-group">
                <span class="fundraisers-filter-group__label">Статуси</span>
                <div class="fundraisers-filter-chips">
                    <span class="fundraisers-filter-chip fundraisers-filter-chip--soft">Терміново</span>
                    <span class="fundraisers-filter-chip fundraisers-filter-chip--soft">Новий (24 год)</span>
                </div>
            </div>
        </aside>

        <div class="fundraisers-content">
            <div class="fundraisers-toolbar">
                <div>
                    <p class="fundraisers-toolbar__kicker">Каталог</p>
                    <h2 class="fundraisers-toolbar__title">Підтримайте збір, який вам близький</h2>
                </div>
                <a class="btn btn-primary" asp-controller="Fundraisers" asp-action="Create">Створити власний збір</a>
            </div>

            @if (Model.Items.Count == 0)
            {
                <article class="placeholder-card fundraiser-empty">
                    <h3 class="fundraiser-empty__title">Поки що зборів немає</h3>
                    <p class="fundraiser-empty__subtitle">Станьте першим, хто розмістить власний збір.</p>
                </article>
            }
            else
            {
                <div class="fundraisers-grid">
                    @foreach (var item in Model.Items)
                    {
                        var progressPercent = item.GoalAmount <= 0
                            ? 0m
                            : Math.Min(100m, Math.Round(item.CurrentAmount / item.GoalAmount * 100m, 0));

                        var authorInitial = string.IsNullOrWhiteSpace(item.AuthorNickName)
                            ? "U"
                            : item.AuthorNickName[..1].ToUpperInvariant();

                        <article class="placeholder-card fundraiser-card">
                            @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                            {
                                <img class="fundraiser-card__media fundraiser-card__media-image" src="@item.CoverImageUrl" alt="Зображення збору @item.Title" />
                            }
                            else
                            {
                                <div class="fundraiser-card__media"></div>
                            }

                            <div class="fundraiser-card__body">
                                <div class="fundraiser-card__meta">
                                    <span class="fundraiser-card__tag">@item.CategoryLabel</span>
                                    <div class="fundraiser-card__status-stack">
                                        @if (item.IsUrgent)
                                        {
                                            <span class="fundraiser-card__status fundraiser-card__status--urgent">Терміново</span>
                                        }

                                        @if (item.IsNew)
                                        {
                                            <span class="fundraiser-card__status fundraiser-card__status--new">Новий</span>
                                        }
                                    </div>
                                </div>

                                <div class="fundraiser-card__title-row">
                                    <span class="fundraiser-author" title="@item.AuthorNickName (@item.AuthorFullName)">
                                        @if (!string.IsNullOrWhiteSpace(item.AuthorProfileImagePath))
                                        {
                                            <img class="fundraiser-author__avatar" src="@item.AuthorProfileImagePath" alt="Аватар автора" />
                                        }
                                        else
                                        {
                                            <span class="fundraiser-author__fallback">@authorInitial</span>
                                        }
                                    </span>
                                    <h3 class="fundraiser-card__title">@item.Title</h3>
                                </div>

                                <p class="fundraiser-card__description">@item.ShortDescription</p>

                                <div class="fundraiser-card__progress-block">
                                    <div class="fundraiser-card__progress-track">
                                        <span class="fundraiser-card__progress-fill" style="width: @progressPercent%"></span>
                                    </div>
                                    <div class="fundraiser-card__progress-meta">
                                        <span>@progressPercent% зібрано</span>
                                        <span>@item.CurrentAmount.ToString("N0") @item.Currency / @item.GoalAmount.ToString("N0") @item.Currency</span>
                                    </div>
                                </div>

                                <a class="btn btn-outline-primary" asp-controller="Fundraisers" asp-action="Details" asp-route-slug="@item.Slug">Переглянути збір</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>

