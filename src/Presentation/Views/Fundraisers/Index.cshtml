@model FundraisersListViewModel
@{
    ViewData["Title"] = "Актуальні збори";
    var selectedCategories = Model.Filters.SelectedCategories.ToHashSet();
    var selectedStatuses = Model.Filters.SelectedStatuses.ToHashSet();
    var hasActiveFilters =
        Model.Filters.SelectedCategories.Count > 0 ||
        Model.Filters.SelectedStatuses.Count > 0 ||
        Model.Filters.SelectedCurrency != "ALL" ||
        Model.Filters.GoalAmountMax < Model.Filters.GoalAmountUpperBound;
}

<section class="app-section">
    <div class="section-header">
        <h1 class="section-title">@ViewData["Title"]</h1>
        <p class="section-subtitle">Список зборів, які зараз потребують підтримки</p>
    </div>

    @if (TempData["FundraiserSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["FundraiserError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="fundraisers-layout">
        <form class="placeholder-card fundraisers-sidebar" aria-label="Фільтри зборів" asp-controller="Fundraisers" asp-action="Index" method="get" data-goal-filter>
            <div class="fundraisers-sidebar__header">
                <p class="fundraisers-sidebar__kicker">Параметри пошуку</p>
                <p class="fundraisers-sidebar__subtitle">Шукай збори за відповідними критеріями</p>
            </div>

            <div class="fundraisers-filter-group">
                <span class="fundraisers-filter-group__label">Категорія</span>
                <div class="fundraisers-filter-chips">
                    <label class="fundraisers-filter-chip @(selectedCategories.Contains(Donately.Domain.Entities.FundraiserCategory.Medicine) ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="checkbox" name="Categories" value="Medicine" @(selectedCategories.Contains(Donately.Domain.Entities.FundraiserCategory.Medicine) ? "checked" : null) />
                        Медицина
                    </label>
                    <label class="fundraisers-filter-chip @(selectedCategories.Contains(Donately.Domain.Entities.FundraiserCategory.MilitarySupport) ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="checkbox" name="Categories" value="MilitarySupport" @(selectedCategories.Contains(Donately.Domain.Entities.FundraiserCategory.MilitarySupport) ? "checked" : null) />
                        Допомога ЗСУ
                    </label>
                    <label class="fundraisers-filter-chip @(selectedCategories.Contains(Donately.Domain.Entities.FundraiserCategory.Support) ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="checkbox" name="Categories" value="Support" @(selectedCategories.Contains(Donately.Domain.Entities.FundraiserCategory.Support) ? "checked" : null) />
                        Підтримка
                    </label>
                </div>
            </div>

            <div class="fundraisers-filter-group">
                <span class="fundraisers-filter-group__label">Статуси</span>
                <div class="fundraisers-filter-chips">
                    <label class="fundraisers-filter-chip fundraisers-filter-chip--soft @(selectedStatuses.Contains("urgent") ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="checkbox" name="Statuses" value="urgent" @(selectedStatuses.Contains("urgent") ? "checked" : null) />
                        Терміново
                    </label>
                    <label class="fundraisers-filter-chip fundraisers-filter-chip--soft @(selectedStatuses.Contains("new") ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="checkbox" name="Statuses" value="new" @(selectedStatuses.Contains("new") ? "checked" : null) />
                        Новий
                    </label>
                </div>
            </div>

            <div class="fundraisers-filter-group">
                <span class="fundraisers-filter-group__label">Валюта</span>
                <div class="fundraisers-filter-chips">
                    <label class="fundraisers-filter-chip fundraisers-filter-chip--soft @(Model.Filters.SelectedCurrency == "ALL" ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="radio" name="Currency" value="ALL" data-goal-currency @(Model.Filters.SelectedCurrency == "ALL" ? "checked" : null) />
                        Усі валюти
                    </label>
                    <label class="fundraisers-filter-chip fundraisers-filter-chip--soft @(Model.Filters.SelectedCurrency == "UAH" ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="radio" name="Currency" value="UAH" data-goal-currency @(Model.Filters.SelectedCurrency == "UAH" ? "checked" : null) />
                        UAH
                    </label>
                    <label class="fundraisers-filter-chip fundraisers-filter-chip--soft @(Model.Filters.SelectedCurrency == "USD" ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="radio" name="Currency" value="USD" data-goal-currency @(Model.Filters.SelectedCurrency == "USD" ? "checked" : null) />
                        USD
                    </label>
                    <label class="fundraisers-filter-chip fundraisers-filter-chip--soft @(Model.Filters.SelectedCurrency == "EUR" ? "fundraisers-filter-chip--active" : string.Empty)">
                        <input class="fundraisers-filter-chip__input" type="radio" name="Currency" value="EUR" data-goal-currency @(Model.Filters.SelectedCurrency == "EUR" ? "checked" : null) />
                        EUR
                    </label>
                </div>
            </div>

            <div class="fundraisers-filter-group">
                <span class="fundraisers-filter-group__label">Ціль збору до</span>
                <div class="fundraisers-filter-range">
                    <input
                        type="range"
                        min="1"
                        max="@Model.Filters.GoalAmountUpperBound"
                        value="@Model.Filters.GoalAmountMax"
                        class="form-range"
                        data-goal-range />

                    <div class="fundraisers-filter-range__labels">
                        <span>1</span>
                        <span data-goal-value>@Model.Filters.GoalAmountMax.ToString("N0")</span>
                    </div>

                    <input
                        type="number"
                        min="1"
                        max="@Model.Filters.GoalAmountUpperBound"
                        value="@Model.Filters.GoalAmountMax"
                        name="GoalAmountMax"
                        class="form-control fundraiser-filter-goal-input"
                        data-goal-input />

                    <small class="fundraisers-filter-range__hint">
                        Максимум для обраної валюти:
                        <span data-goal-max>@Model.Filters.GoalAmountUpperBound.ToString("N0")</span>
                    </small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary fundraisers-filter-apply">Застосувати</button>
            @if (hasActiveFilters)
            {
                <a class="btn btn-link fundraisers-filter-reset" asp-controller="Fundraisers" asp-action="Index">Скинути</a>
            }
        </form>

        <div class="fundraisers-content">
            <div class="fundraisers-toolbar">
                <div>
                    <p class="fundraisers-toolbar__kicker">Каталог</p>
                    <h2 class="fundraisers-toolbar__title">Підтримайте збір, який вам близький</h2>
                </div>
                <a class="btn btn-primary" asp-controller="Fundraisers" asp-action="Create">Створити власний збір</a>
            </div>

            @if (Model.Items.Count == 0)
            {
                <article class="placeholder-card fundraiser-empty">
                    <h3 class="fundraiser-empty__title">Поки що зборів немає</h3>
                    <p class="fundraiser-empty__subtitle">Станьте першим, хто розмістить власний збір.</p>
                </article>
            }
            else
            {
                <div class="fundraisers-grid">
                    @foreach (var item in Model.Items)
                    {
                        var progressPercent = item.GoalAmount <= 0
                            ? 0m
                            : Math.Min(100m, Math.Round(item.CurrentAmount / item.GoalAmount * 100m, 0));
                        var hasCoverImage = !string.IsNullOrWhiteSpace(item.CoverImageUrl);

                        var authorInitial = string.IsNullOrWhiteSpace(item.AuthorNickName)
                            ? "U"
                            : item.AuthorNickName[..1].ToUpperInvariant();

                        <article class="placeholder-card fundraiser-card">
                            @if (hasCoverImage)
                            {
                                <div class="fundraiser-card__media">
                                    <img class="fundraiser-card__media-image" src="@item.CoverImageUrl" alt="Зображення збору @item.Title" />
                                </div>
                            }
                            else
                            {
                                <div class="fundraiser-card__media fundraiser-card__media--placeholder"></div>
                            }

                            <div class="fundraiser-card__body">
                                <div class="fundraiser-card__meta">
                                    <span class="fundraiser-card__tag">@item.CategoryLabel</span>
                                    @if (item.IsUrgent || item.IsNew)
                                    {
                                        <div class="fundraiser-card__status-stack">
                                            @if (item.IsUrgent)
                                            {
                                                <span class="fundraiser-card__status fundraiser-card__status--urgent">Терміново</span>
                                            }

                                            @if (item.IsNew)
                                            {
                                                <span class="fundraiser-card__status fundraiser-card__status--new">Новий</span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="fundraiser-card__title-row">
                                    <span class="fundraiser-author" title="@item.AuthorNickName (@item.AuthorFullName)">
                                        @if (!string.IsNullOrWhiteSpace(item.AuthorProfileImagePath))
                                        {
                                            <img class="fundraiser-author__avatar" src="@item.AuthorProfileImagePath" alt="Аватар автора" />
                                        }
                                        else
                                        {
                                            <span class="fundraiser-author__fallback">@authorInitial</span>
                                        }
                                    </span>
                                    <h3 class="fundraiser-card__title">@item.Title</h3>
                                </div>

                                <p class="fundraiser-card__description">@item.ShortDescription</p>

                                <div class="fundraiser-card__progress-block">
                                    <div class="fundraiser-card__progress-track">
                                        <span class="fundraiser-card__progress-fill" style="width: @progressPercent%"></span>
                                    </div>
                                    <div class="fundraiser-card__progress-meta">
                                        <span>@progressPercent% зібрано</span>
                                        <span>@item.CurrentAmount.ToString("N0") @item.Currency / @item.GoalAmount.ToString("N0") @item.Currency</span>
                                    </div>
                                </div>

                                <a class="btn btn-outline-primary fundraiser-card__action" asp-controller="Fundraisers" asp-action="Details" asp-route-slug="@item.Slug">Переглянути збір</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>

