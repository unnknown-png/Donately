@using Donately.Domain.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Donately</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Donately.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header border-bottom box-shadow">
        <nav class="navbar navbar-light bg-white">
            <div class="container-fluid app-header__container">
                <a class="navbar-brand app-header__brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Donately на головну сторінку">
                    <span class="app-header__logo" aria-hidden="true">🤝</span>
                    <span class="app-header__title">Donately</span>
                </a>

                <div class="app-header__actions">
                    <a class="app-header__link" asp-area="" asp-controller="Home" asp-action="Index">Головна</a>
                    <a class="app-header__link app-header__link--featured" asp-area="" asp-controller="Fundraisers" asp-action="Index">Актуальні збори</a>
                    <a class="app-header__link" asp-area="" asp-controller="Statistics" asp-action="Index">Статистика</a>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var headerUserName = currentUser?.UserName ?? User.Identity?.Name ?? "Користувач";
                    var headerAvatarPath = string.IsNullOrWhiteSpace(currentUser?.ProfileImagePath)
                        ? null
                        : currentUser.ProfileImagePath;
                    var headerAvatarFallback = string.IsNullOrWhiteSpace(headerUserName)
                        ? "U"
                        : headerUserName[..1].ToUpperInvariant();

                    <a class="app-header__profile" asp-area="" asp-controller="Profile" asp-action="Index" aria-label="Профіль користувача">
                        <span class="app-header__profile-name">@headerUserName</span>
                        <span class="app-header__avatar">
                            @if (headerAvatarPath is not null)
                            {
                                <img src="@headerAvatarPath" alt="Аватар користувача" class="app-header__avatar-image" />
                            }
                            else
                            {
                                <span class="app-header__avatar-fallback" aria-hidden="true">@headerAvatarFallback</span>
                            }
                        </span>
                    </a>
                }
                else
                {
                    <div class="app-header__auth-actions">
                        <a class="app-header__auth-btn app-header__auth-btn--outline" asp-area="" asp-controller="Auth" asp-action="Register">Зареєструватись</a>
                        <a class="app-header__auth-btn app-header__auth-btn--solid" asp-area="" asp-controller="Auth" asp-action="Login">Увійти</a>
                    </div>
                }
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer footer--enhanced">
        <div class="container footer__container">
            <div class="footer__brand-block">
                <div class="footer__brand" aria-label="Donately">
                    <span class="footer__logo" aria-hidden="true">🤝</span>
                    <span class="footer__title">Donately</span>
                </div>
                <p class="footer__copy">@DateTime.Now.Year - Donately</p>
                <p class="footer__author">Андрій Кахновець</p>
            </div>

            <div class="footer__links-block">
                <h2 class="footer__heading">Контакти</h2>
                <div class="footer__contacts-grid">
                    <div class="footer__contacts-column">
                        <ul class="footer__links-list">
                            <li><a class="footer__link" href="https://github.com/unnknown-png" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                            <li><a class="footer__link" href="https://t.me/unnknown_png" target="_blank" rel="noopener noreferrer">Telegram</a></li>
                        </ul>
                    </div>

                    <div class="footer__contacts-column footer__contacts-column--accent">
                        <ul class="footer__links-list">
                            <li><a class="footer__link" href="mailto:kahnovets.ap@gmail.com">Email підтримки</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
