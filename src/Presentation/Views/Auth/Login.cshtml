@model LoginViewModel

@{
    ViewData["Title"] = "Вхід";
}

<section class="auth-page">
    <article class="placeholder-card auth-card auth-card--compact">
        <div class="auth-card__header">
            <h1 class="auth-card__title">Вхід в акаунт</h1>
            <p class="auth-card__subtitle">Зроби свій внесок вже сьогодні)</p>
        </div>

        <form asp-action="Login" asp-controller="Auth" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()

            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation"></div>

            <div class="auth-form__group">
                <label asp-for="Email" class="auth-form__label">Email</label>
                <input asp-for="Email" class="form-control auth-form__input" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-form__group">
                <label asp-for="Password" class="auth-form__label">Пароль</label>
                <input asp-for="Password" class="form-control auth-form__input" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check auth-form__checkbox-row">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Запам'ятати мене</label>
            </div>

            <a asp-controller="Auth" asp-action="ForgotPassword" class="link-secondary text-decoration-none">Забули пароль?</a>

            <button type="submit" class="btn btn-primary auth-form__submit">Увійти</button>
            <a class="btn btn-outline-primary auth-form__submit" asp-controller="Auth" asp-action="Register">Зареєструватись</a>
        </form>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

