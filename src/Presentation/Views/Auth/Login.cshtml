@{
    ViewData["Title"] = "Вхід";
}

<section class="auth-page">
    <article class="placeholder-card auth-card auth-card--compact">
        <div class="auth-card__header">
            <h1 class="auth-card__title">Сторінка входу</h1>
            <p class="auth-card__subtitle">Функціонал входу реалізуємо наступним кроком.</p>
        </div>

        <a class="btn btn-primary auth-form__submit" asp-controller="Auth" asp-action="Register">Перейти до реєстрації</a>
    </article>
</section>

