@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Скидання пароля";
}

<section class="auth-page">
    <article class="placeholder-card auth-card auth-card--compact">
        <div class="auth-card__header">
            <h1 class="auth-card__title">Скидання пароля</h1>
            <p class="auth-card__subtitle">Вкажіть email і встановіть новий пароль.</p>
        </div>

        <form asp-action="ResetPassword" asp-controller="Auth" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation"></div>

            <div class="auth-form__group">
                <label asp-for="Email" class="auth-form__label">Email</label>
                <input asp-for="Email" class="form-control auth-form__input" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="auth-form__group">
                <label asp-for="Password" class="auth-form__label">Новий пароль</label>
                <input asp-for="Password" class="form-control auth-form__input" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-form__group">
                <label asp-for="ConfirmPassword" class="auth-form__label">Підтвердіть пароль</label>
                <input asp-for="ConfirmPassword" class="form-control auth-form__input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-form__submit">Скинути пароль</button>
        </form>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

