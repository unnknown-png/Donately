@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Відновлення пароля";
}

<section class="auth-page">
    <article class="placeholder-card auth-card auth-card--compact">
        <div class="auth-card__header">
            <h1 class="auth-card__title">Відновлення пароля</h1>
            <p class="auth-card__subtitle">Вкажіть email, і ми надішлемо посилання для скидання пароля.</p>
        </div>

        @if (Model.EmailSent)
        {
            <div class="alert alert-success auth-alert" role="alert">
                Перевірте пошту: ми надіслали лист з посиланням для скидання пароля. Лист може потрапити у спам.
            </div>
        }

        <form asp-action="ForgotPassword" asp-controller="Auth" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation"></div>

            <div class="auth-form__group">
                <label asp-for="Email" class="auth-form__label">Email</label>
                <input asp-for="Email" class="form-control auth-form__input" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-form__submit">Надіслати посилання</button>
            <a class="btn btn-outline-primary auth-form__submit" asp-controller="Auth" asp-action="Login">Повернутись до входу</a>
        </form>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

