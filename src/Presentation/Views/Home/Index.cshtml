@model HomeIndexViewModel
@{
    ViewData["Title"] = "Головна";
}

<section class="home-hero app-section app-section--hero">
    <div class="home-hero__content">
        <p class="home-kicker">Donately</p>
        <h1 class="home-title">Одна добра справа змінює світ</h1>
        <p class="home-subtitle">
            Створюй, підтримуй і змінюй чиєсь життя на краще!
        </p>

        <div class="home-hero__actions">
            <a class="btn btn-primary btn-lg home-action" asp-area="" asp-controller="Fundraisers" asp-action="Index">Підтримати</a>
            <a class="btn btn-outline-primary btn-lg home-action home-action--secondary" asp-area="" asp-controller="Fundraisers" asp-action="Create">Створити збір</a>
        </div>
    </div>

    <div class="home-hero__visual" aria-hidden="true">
        <div class="home-hero__panel home-hero__panel--accent"></div>
        <div class="home-hero__panel home-hero__panel--cards"></div>
    </div>
</section>

<section class="app-section">
    <div class="section-header">
        <h2 class="section-title">Останні донати</h2>
        <p class="section-subtitle">Подивись, хто брав участь в підтримці зборів</p>
    </div>

    <div class="recent-donations-feed"
         data-recent-donations-feed
         data-feed-url="@Url.Action("RecentDonations", "Home")"
         data-refresh-interval="12000">
        <button type="button"
                class="recent-donations-arrow recent-donations-arrow--prev"
                data-recent-donations-prev
                aria-label="Прокрутити останні донати вліво">
            <span aria-hidden="true">‹</span>
        </button>

        <div class="recent-donations-track" data-recent-donations-track>
            @await Html.PartialAsync("_RecentDonationsCards", Model.RecentDonations)
        </div>

        <button type="button"
                class="recent-donations-arrow recent-donations-arrow--next"
                data-recent-donations-next
                aria-label="Прокрутити останні донати вправо">
            <span aria-hidden="true">›</span>
        </button>
    </div>
</section>

<section class="app-section">
    <div class="section-header">
        <h2 class="section-title">Активність</h2>
        <p class="section-subtitle">Невеличкі досягнення нашого застосунку)</p>
    </div>

    <div class="achievements-grid">
        <article class="achievement-card">
            <span class="achievement-card__label">Зібрано коштів</span>
            <strong class="achievement-card__value">—</strong>
            <span class="achievement-card__hint">Фінальна сума з усіх активних зборів</span>
        </article>

        <article class="achievement-card">
            <span class="achievement-card__label">Підтримано зборів</span>
            <strong class="achievement-card__value">—</strong>
            <span class="achievement-card__hint">Кількість підтриманих зборів</span>
        </article>

        <article class="achievement-card">
            <span class="achievement-card__label">Активних зборів</span>
            <strong class="achievement-card__value">—</strong>
            <span class="achievement-card__hint">Збори, що зараз очікують на допомогу</span>
        </article>
    </div>
</section>
