@model UserProfileViewModel

@{
    ViewData["Title"] = "Твій профіль";
    var profileSince = $"Разом з Donately від {Model.CreatedAt.ToLocalTime():dd.MM.yyyy}";

    var fullNameParts = Model.FullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Where(x => x.Any(char.IsLetter))
        .Take(2)
        .Select(x => char.ToUpperInvariant(x.First(char.IsLetter)))
        .ToArray();

    var initials = fullNameParts.Length > 0
        ? string.Concat(fullNameParts)
        : string.Concat(Model.UserName.Where(char.IsLetter).Take(2)).ToUpperInvariant();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "👤";
    }

    var hasAvatar = !string.IsNullOrWhiteSpace(Model.ProfileImagePath);
    var currentStep = Model.CurrentVerificationStep;
    var step3Centered = currentStep < 3;
    var step4Centered = currentStep < 4;
    var isVerificationApproved = string.Equals(Model.VerificationStatusLabel, "Верифіковано", StringComparison.OrdinalIgnoreCase);
    var isVerificationRejected = string.Equals(Model.VerificationStatusLabel, "Відхилено", StringComparison.OrdinalIgnoreCase);
}

<section class="app-section">
    @if (TempData["ProfileSuccess"] is string successMessage)
    {
        <div class="alert alert-success profile-alert" role="alert">@successMessage</div>
    }

    @if (TempData["ProfileError"] is string errorMessage)
    {
        <div class="alert alert-danger profile-alert" role="alert">@errorMessage</div>
    }

    <div class="section-header">
        <h1 class="section-title">@ViewData["Title"]</h1>
    </div>

    <div class="profile-stack">
        <article class="placeholder-card profile-card profile-card--summary">
            <div class="profile-card__avatar-wrap">
                <form asp-controller="Profile" asp-action="UpdateAvatar" method="post" enctype="multipart/form-data" class="profile-avatar-form">
                    @Html.AntiForgeryToken()
                    <input id="avatarInput" name="avatar" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="profile-avatar-form__input" data-avatar-input />

                    <label for="avatarInput" class="profile-avatar-form__trigger" title="Змінити аватар">
                        @if (hasAvatar)
                        {
                            <img src="@Model.ProfileImagePath" alt="Аватар користувача" class="profile-card__avatar-image" />
                        }
                        else
                        {
                            <span class="profile-card__avatar">@initials</span>
                        }
                    </label>
                </form>
            </div>

            <div class="profile-card__content">
                <div class="profile-card__identity">
                    <div>
                        <p class="profile-card__name">@Model.FullName</p>
                        <p class="profile-card__role">@@@Model.UserName</p>
                    </div>
                    <span class="profile-card__status">Новий користувач</span>
                </div>

                <div class="profile-about">
                    <span class="profile-about__label">Про себе</span>

                    <button type="button" class="profile-about__display" data-profile-about-open>
                        @(string.IsNullOrWhiteSpace(Model.Bio) ? "Натисни, щоб додати інформацію про себе" : Model.Bio)
                    </button>

                    <form asp-controller="Profile" asp-action="UpdateBio" method="post" class="profile-about__form" data-profile-about-form hidden>
                        @Html.AntiForgeryToken()
                        <textarea name="Bio" class="form-control profile-about__textarea" rows="3" maxlength="1000" placeholder="Напиши коротко про себе">@Model.Bio</textarea>
                        <div class="profile-about__actions">
                            <button type="submit" class="btn btn-primary btn-sm">Зберегти</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-profile-about-cancel>Скасувати</button>
                        </div>
                    </form>
                </div>

                <div class="profile-card__meta">
                    <span class="profile-card__meta-item">@profileSince</span>

                    <div class="profile-card__meta-item profile-location">
                        <button type="button" class="profile-location__display" data-profile-location-open>
                            @(string.IsNullOrWhiteSpace(Model.Location) ? "Натисни, щоб додати місто, країну" : Model.Location)
                        </button>

                        <form asp-controller="Profile" asp-action="UpdateLocation" method="post" class="profile-location__form" data-profile-location-form hidden>
                            @Html.AntiForgeryToken()
                            <input name="Location" value="@Model.Location" class="form-control profile-location__input" maxlength="200" placeholder="Місто, країна" />
                            <div class="profile-about__actions">
                                <button type="submit" class="btn btn-primary btn-sm">Зберегти</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-profile-location-cancel>Скасувати</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </article>

        <article class="placeholder-card profile-card profile-card--details">
            <div class="profile-card__header">
                <div>
                    <h2 class="profile-card__title">Особисті дані</h2>
                </div>

                <button type="button" class="profile-edit-button" data-profile-edit-open>
                    <span>Редагувати</span>
                    <span aria-hidden="true">✎</span>
                </button>
            </div>

            <div class="profile-info-grid" data-profile-details-display>
                <div class="profile-info-item">
                    <span class="profile-info-item__label">Username</span>
                    <strong class="profile-info-item__value">@Model.UserName</strong>
                </div>

                <div class="profile-info-item">
                    <span class="profile-info-item__label">Full Name</span>
                    <strong class="profile-info-item__value">@Model.FullName</strong>
                </div>

                <div class="profile-info-item">
                    <span class="profile-info-item__label">Email</span>
                    <strong class="profile-info-item__value">@Model.Email</strong>
                </div>

                <div class="profile-info-item">
                    <span class="profile-info-item__label">Phone Number</span>
                    <strong class="profile-info-item__value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</strong>
                </div>

                <div class="profile-info-item">
                    <span class="profile-info-item__label">Date of Birth</span>
                    <strong class="profile-info-item__value">@(Model.DateOfBirth?.ToString("dd.MM.yyyy") ?? "—")</strong>
                </div>
            </div>

            <form asp-controller="Profile" asp-action="UpdateDetails" method="post" class="profile-edit-form" data-profile-details-form hidden>
                @Html.AntiForgeryToken()

                <div class="profile-edit-form__grid">
                    <div class="profile-edit-form__field">
                        <label for="editUserName" class="profile-edit-form__label">Username</label>
                        <input id="editUserName" name="UserName" value="@Model.UserName" class="form-control" maxlength="50" required />
                    </div>

                    <div class="profile-edit-form__field">
                        <label for="editEmail" class="profile-edit-form__label">Email</label>
                        <input id="editEmail" name="Email" type="email" value="@Model.Email" class="form-control" required />
                    </div>

                    <div class="profile-edit-form__field">
                        <label for="editPhoneNumber" class="profile-edit-form__label">Phone Number</label>
                        <input id="editPhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" maxlength="30" />
                    </div>

                    <div class="profile-edit-form__field">
                        <label for="editDateOfBirth" class="profile-edit-form__label">Date of Birth</label>
                        <input id="editDateOfBirth" name="DateOfBirth" type="date" value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                </div>

                <div class="profile-edit-form__actions">
                    <button type="submit" class="btn btn-primary btn-sm">Зберегти зміни</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-profile-edit-cancel>Скасувати</button>
                </div>
            </form>
        </article>

        <article class="placeholder-card profile-card profile-card--verification">
            <div class="profile-card__header">
                <div>
                    <h2 class="profile-card__title">Верифікація</h2>
                    <p class="profile-card__subtitle">Виконай кроки нижче, щоб перейти до статусу очікування верифікації.</p>
                </div>

                <span class="profile-verification__pill">@Model.VerificationStatusLabel</span>
            </div>

            <div class="profile-verification__steps">
                <div class="profile-verification__step @(currentStep > 1 ? "profile-verification__step--done" : currentStep == 1 ? "profile-verification__step--active" : string.Empty)">
                    <span class="profile-verification__step-index @(currentStep > 1 ? "profile-verification__step-index--done" : string.Empty)">
                        @(currentStep > 1 ? "✓" : "1")
                    </span>
                    <div class="profile-verification__step-content">
                        <div class="profile-verification__step-header">
                            <p class="profile-verification__step-title">Підтвердження мейлу</p>

                            @if (currentStep > 1)
                            {
                                <span class="profile-verification__step-status profile-verification__step-status--success">Підтверджено</span>
                            }
                            else if (currentStep == 1)
                            {
                                <a asp-controller="Verification" asp-action="Email" class="btn btn-primary btn-sm profile-verification__start-button">Розпочати</a>
                            }
                        </div>

                        <p class="profile-verification__step-text">@(currentStep > 1 ? "Email успішно підтверджено." : "Підтверди email, щоб перейти до наступних етапів верифікації.")</p>
                    </div>
                </div>

                <div class="profile-verification__step @(currentStep > 2 ? "profile-verification__step--done" : currentStep == 2 ? "profile-verification__step--active" : string.Empty)">
                    <span class="profile-verification__step-index @(currentStep > 2 ? "profile-verification__step-index--done" : string.Empty)">
                        @(currentStep > 2 ? "✓" : "2")
                    </span>
                    <div class="profile-verification__step-content">
                        <div class="profile-verification__step-header">
                            <p class="profile-verification__step-title">Підтвердження номеру телефону</p>

                            @if (currentStep > 2)
                            {
                                <span class="profile-verification__step-status profile-verification__step-status--success">Підтверджено</span>
                            }
                            else if (currentStep == 2)
                            {
                                <a asp-controller="Verification" asp-action="Phone" class="btn btn-primary btn-sm profile-verification__start-button">Розпочати</a>
                            }
                        </div>

                        @if (currentStep >= 2)
                        {
                            <p class="profile-verification__step-text">@(currentStep > 2 ? "Номер телефону підтверджено успішно." : "Підтверди номер телефону через SMS-код, щоб перейти далі.")</p>
                        }
                    </div>
                </div>

                <div class="profile-verification__step @(currentStep > 3 ? "profile-verification__step--done" : currentStep == 3 ? "profile-verification__step--active" : string.Empty)">
                    <span class="profile-verification__step-index @(currentStep > 3 ? "profile-verification__step-index--done" : string.Empty)">
                        @(currentStep > 3 ? "✓" : "3")
                    </span>
                    <div class="profile-verification__step-content @(step3Centered ? "profile-verification__step-content--centered" : string.Empty)">
                        <div class="profile-verification__step-header">
                            <p class="profile-verification__step-title">Додати документ</p>

                            @if (currentStep > 3)
                            {
                                <span class="profile-verification__step-status profile-verification__step-status--success">Підтверджено</span>
                            }
                            else if (currentStep == 3)
                            {
                                <a asp-controller="Verification" asp-action="Document" class="btn btn-primary btn-sm profile-verification__start-button">Розпочати</a>
                            }
                        </div>

                        @if (currentStep == 3)
                        {
                            <p class="profile-verification__step-text">Прикріпи фото паспорта або студентського квитка, щоб перейти далі.</p>
                        }
                        else if (currentStep > 3)
                        {
                            <p class="profile-verification__step-text">Документ успішно прикріплено та відправлено на перевірку.</p>
                        }
                    </div>
                </div>

                <div class="profile-verification__step @(currentStep == 4 ? "profile-verification__step--active" : currentStep > 4 ? "profile-verification__step--done" : string.Empty)">
                    <span class="profile-verification__step-index @(currentStep > 4 ? "profile-verification__step-index--done" : string.Empty)">
                        @(currentStep > 4 ? "✓" : "4")
                    </span>
                    <div class="profile-verification__step-content @(step4Centered ? "profile-verification__step-content--centered" : string.Empty)">
                        <div class="profile-verification__step-header">
                            <p class="profile-verification__step-title">Отримати статус</p>

                            @if (currentStep > 4)
                            {
                                <span class="profile-verification__step-status @(isVerificationRejected ? "profile-verification__step-status--danger" : "profile-verification__step-status--success")">@Model.VerificationStatusLabel</span>
                            }
                        </div>

                        @if (currentStep == 4)
                        {
                            <p class="profile-verification__step-text">Вашу заявку зараз перевіряє адміністратор.</p>
                        }
                        else if (currentStep > 4)
                        {
                            <p class="profile-verification__step-text">@(isVerificationApproved ? "Верифікацію підтверджено. Тепер ти можеш створювати власні збори." : "Верифікацію відхилено. Переглянь вимоги та спробуй ще раз.")</p>
                        }
                    </div>
                </div>
            </div>
        </article>

        <article class="placeholder-card profile-card profile-card--logout">
            <form asp-controller="Auth" asp-action="Logout" method="post" class="profile-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger profile-logout-button">Вийти з акаунту</button>
            </form>
        </article>
    </div>
</section>

